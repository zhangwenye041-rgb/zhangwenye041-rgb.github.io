---
/**
 * HomeView — 精简自定义后的首页视图组件
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import ProofTile from '@/components/ui/data-display/ProofTile/ProofTile.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import StackMarquee from '@/components/landing/StackMarquee.astro';
import { getCollection } from 'astro:content';
import siteConfig from '@/config/site.config';
import { getPostUrl, getPublishedPosts } from '@/lib/blog';
import { getVisibleProjects } from '@/lib/projects';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import { t, tData, defaultLocale, localizedPath } from '@/i18n';

interface Props {
  locale?: string;
}

interface IconCard {
  icon: string;
  title: string;
  description: string;
}

const { locale = defaultLocale } = Astro.props;

// 加载当前语言的精选项目
let projectItems = await getVisibleProjects(locale);
if (projectItems.length === 0 && locale !== defaultLocale) {
  projectItems = await getVisibleProjects(defaultLocale);
}
const featuredProjects = projectItems
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// 加载当前语言的最新博客
let postItems = await getPublishedPosts(locale);
if (postItems.length === 0 && locale !== defaultLocale) {
  postItems = await getPublishedPosts(defaultLocale);
}
const posts = [...postItems]
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
  })
  .slice(0, 4);

// 修改点 1：自定义 Hero 跑马灯要展示的技术栈图标（确保 src/content/stack/ 存在对应文件）
const heroStackOrder = ['Astro', 'Tailwind CSS', 'TypeScript', 'GitHub'];
const heroStackItems = (await getCollection('stack'))
  .filter((e) => heroStackOrder.includes(e.data.name))
  .sort((a, b) => heroStackOrder.indexOf(a.data.name) - heroStackOrder.indexOf(b.data.name))
  .map((e) => ({
    name: e.data.name,
    icon: e.data.icon,
    url: e.data.url,
    version: e.data.version,
    colorOklch: e.data.colorOklch,
  }));

// 读取 JSON 语言包数据
const hero = tData<{
  badge: string;
  titleLine1: string;
  titleLine2: string;
  titleLine3: string;
  description: string;
  descriptionMobile: string;
  github: string;
  getStarted: string;
}>('pages.home.hero', locale)!;

const workWithMe = tData<{ badge: string; heading: string; lead: string; cards: IconCard[]; cta: string }>(
  'pages.home.workWithMe',
  locale
)!;

const portfolio = tData<{ badge: string; heading: string; lead: string; viewAll: string }>('pages.home.portfolio', locale)!;

const aboutTeaser = tData<{
  badge: string;
  headingLine1: string;
  headingLine2: string;
  para2: string;
  moreAboutMe: string;
  statsIntro: string;
  stat1: string;
  stat2: string;
  stat3: string;
  basedIn: string;
}>('pages.home.aboutTeaser', locale)!;

const blogSection = tData<{ badge: string; heading: string; viewAll: string }>('pages.home.blog', locale)!;
const cta = tData<{ badge: string; heading: string; description: string; primary: string; secondary: string }>(
  'pages.home.cta',
  locale
)!;

const projectsUrl = localizedPath('/projects', locale);
const aboutUrl = localizedPath('/about', locale);
const contactUrl = localizedPath('/contact', locale);
const blogUrl = localizedPath('/blog', locale);

// 修改点 2：把原本指向模板教程的链接修改为直接指向首页项目区锚点 `#work`
const getStartedUrl = '#work';

// 城市与位置显示逻辑
const city = siteConfig.address?.city;
const country = siteConfig.address?.country;
const location = city ? (country ? `${city}, ${country}` : city) : '';
const aboutPara1 = location
  ? t('pages.home.aboutTeaser.para1WithLocation', locale, { location })
  : t('pages.home.aboutTeaser.para1NoLocation', locale);
const basedInDisplay = `${city ?? 'Shenzhen'}${country ? `, ${country}` : ''}`;
---

<LandingLayout
  title={t('pages.home.meta.title', locale)}
  description={t('pages.home.meta.description', locale)}
  includePersonSchema={true}
  includeProfessionalServiceSchema={true}
>
  <!-- Hero 屏 -->
  <Hero layout="centered" size="xl" class="hero-dark-gradient" fullHeight>
    <Badge slot="badge" variant="brand" pill pulse class="dark:text-brand-200">{hero.badge}</Badge>

    <h1 slot="title" class="!text-[clamp(2rem,12.6vw,3rem)] sm:!text-5xl md:!text-6xl lg:!text-7xl">
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor] whitespace-nowrap">{hero.titleLine1}</span><br />
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">{hero.titleLine2}</span><br class="md:hidden" /><span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">{' '}{hero.titleLine3}</span>
    </h1>

    <p slot="description" class="!text-balance">
      <span class="sm:hidden">{hero.descriptionMobile}</span>
      <span class="hidden sm:inline">{hero.description}</span>
    </p>

    <Fragment slot="actions">
      <!-- 修改点 3：修改为你的个人 GitHub 链接 -->
      <Button size="lg" href="https://github.com/zhangwenye041-rgb" target="_blank" rel="noopener noreferrer">
        {hero.github}
        <Icon name="arrow-right" size="sm" />
      </Button>
      <Button size="lg" variant="outline" href={getStartedUrl}>
        <Icon name="rocket" size="sm" />
        {hero.getStarted}
        <Icon name="arrow-right" size="sm" />
      </Button>
    </Fragment>

    <div slot="bottom" class="mx-auto w-full max-w-6xl px-6">
      <div class="hp-hero-marquee" aria-hidden="true">
        <StackMarquee items={heroStackItems} rows={1} duration={55} pauseOnHover={false} linked={false} cardWidth="auto" gap="1rem" />
      </div>
      <div class="hp-hero-logos" aria-hidden="true">
        {heroStackItems.slice(0, 4).map((item) => (
          <span class="hp-hero-logo">
            <Icon name={item.icon} size="lg" />
          </span>
        ))}
      </div>
    </div>
  </Hero>

  <!-- 工程原则 / 工作理念 -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="handshake" size="sm" />
            {workWithMe.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-balance">
            {workWithMe.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto text-balance">
          {workWithMe.lead}
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {workWithMe.cards.map((card, i) => (
          <ProofTile icon={card.icon} title={card.title} data-reveal data-reveal-delay={i || undefined}>
            {card.description}
          </ProofTile>
        ))}
      </div>

      <div class="flex justify-center mt-4" data-reveal>
        <Button size="lg" href={aboutUrl} class="cta-btn-brand">
          {workWithMe.cta}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  <!-- 项目展示 (Portfolio) -->
  <section id="work" class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4 text-center" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <Badge variant="brand" pill>
            <Icon name="layers" size="sm" />
            {portfolio.badge}
          </Badge>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
            {portfolio.heading}
          </h2>
        </div>
        <p class="text-lg text-foreground-muted max-w-2xl mx-auto">
          {portfolio.lead}
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {featuredProjects.map((project, i) => (
          <ProjectCard project={project} index={i} locale={project.data.locale} />
        ))}
      </div>

      <div class="text-center mt-4">
        <Button variant="brand-outline" href={projectsUrl}>
          {portfolio.viewAll}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  <!-- 关于我预览 (About Teaser) -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-10 glitch:grid-cols-2 glitch:gap-12">
        <div class="flex flex-col justify-center sm:items-center sm:text-center glitch:items-start glitch:text-left" data-reveal data-reveal-ease="smooth">
          <div class="flex flex-col gap-6 mb-6 sm:items-center glitch:items-start">
            <Badge variant="brand" pill class="self-start sm:self-center glitch:self-start">
              <Icon name="user" size="sm" />
              {aboutTeaser.badge}
            </Badge>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              {aboutTeaser.headingLine1}<br />
              <span class="text-brand-500">{aboutTeaser.headingLine2}</span>
            </h2>
          </div>
          <p class="text-lg text-foreground-muted leading-relaxed mb-4 sm:mb-0 sm:max-w-xl glitch:mb-4 glitch:max-w-none">
           {aboutPara1}
          </p>
          <p class="text-lg text-foreground-muted leading-relaxed mb-8 sm:max-w-xl glitch:max-w-none sm:hidden glitch:block">
           {aboutTeaser.para2}
          </p>
           <Button variant="brand-outline" href={aboutUrl} class="self-start sm:self-center glitch:self-start sm:hidden glitch:inline-flex">
            {aboutTeaser.moreAboutMe}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
        <Card variant="elevated" padding="lg" class="h-full flex flex-col" data-reveal data-reveal-delay="1" data-reveal-ease="smooth">
          <p class="text-sm font-bold text-brand-500 mb-5 text-center sm:hidden glitch:block">{aboutTeaser.statsIntro}</p>
          <div class="grid grid-cols-2 sm:grid-cols-4 glitch:grid-cols-2 gap-3 flex-1 auto-rows-fr">
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="history" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">{aboutTeaser.stat1}</p>
            </div>
            
            <!-- 修改点 4：将原本指向 astro.build 的卡片改为本地展示 div -->
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="cpu" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">{aboutTeaser.stat2}</p>
            </div>

            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="globe" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">{aboutTeaser.stat3}</p>
            </div>
            <div class="bg-background-tertiary rounded-xl p-5 flex flex-col items-center justify-center text-center gap-2 border-t-2 border-brand-500/40 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 cursor-default h-full">
              <Icon name="map-pin" class="w-10 h-10 text-brand-500" />
              <p class="text-sm font-semibold text-foreground">{aboutTeaser.basedIn} <br class="sm:hidden" />{basedInDisplay}</p>
            </div>
          </div>
        </Card>
        <div class="hidden sm:flex justify-center glitch:hidden" data-reveal data-reveal-delay="2">
          <Button variant="brand-outline" href={aboutUrl}>
            {aboutTeaser.moreAboutMe}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 最新博客 (Blog) -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-6 text-center" data-reveal>
        <Badge variant="brand" pill>
          <Icon name="book" size="sm" />
          {blogSection.badge}
        </Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          {blogSection.heading}
        </h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, index) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={getPostUrl(post.id, post.data.locale)}
            publishedAt={post.data.publishedAt}
            tags={post.data.tags}
            author={post.data.author}
            image={post.data.image}
            svgSlug={post.data.svgSlug}
            body={post.body}
            revealDelay={index}
            class={index === 3 ? 'hidden sm:block lg:hidden' : undefined}
          />
        ))}
      </div>

      <div class="flex justify-center">
        <Button variant="brand-outline" href={blogUrl}>
          {blogSection.viewAll}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  <!-- 底部联系 (CTA) -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="glitch:hidden mx-auto max-w-2xl px-6 text-center" data-reveal>
      <Badge variant="brand" pill class="mb-6">
        <Icon name="message-circle" size="sm" />
        {cta.badge}
      </Badge>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {cta.heading}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {cta.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href={contactUrl} class="cta-btn-brand">
          {cta.primary}
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="brand-outline" href={aboutUrl}>
          {cta.secondary}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>

    <LetterGlitchBand>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {cta.heading}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {cta.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href={contactUrl} class="hero-btn-brand">
          {cta.primary}
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href={aboutUrl}>
          {cta.secondary}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </LetterGlitchBand>
  </section>

<script>
  function initCountup() {
    const counters = document.querySelectorAll<HTMLElement>('[data-countup]:not([data-countup-init])');
    if (counters.length === 0) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.countup ?? '0', 10);
        const suffix = el.dataset.suffix ?? '';
        const duration = 1200;
        const start = performance.now();
        const tick = (now: number) => {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round(eased * target) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });
    counters.forEach((el) => {
      el.dataset.countupInit = 'true';
      observer.observe(el);
    });
  }

  initCountup();
</script>

<style is:global>
  @media (min-width: 768px) {
    .hero-dark-gradient .hero-title-slot + div {
      max-width: 48rem;
    }
  }

  .hp-hero-marquee .stack-marquee-item > * {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    padding-left: var(--space-3);
    padding-right: var(--space-3);
  }
  
  .hp-hero-marquee .stack-marquee-item .font-display {
    font-weight: 500;
    color: var(--color-foreground-muted);
  }

  section.hero-dark-gradient {
    --hero-floor-gap: var(--space-16);
    padding-bottom: var(--space-16);
  }
  
  .hp-hero-marquee {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hp-hero-marquee {
      animation: hp-hero-marquee-fade 0.6s ease-out 1.2s backwards;
    }
  }
  
  @keyframes hp-hero-marquee-fade {
    from { opacity: 0.01; }
    to   { opacity: 1; }
  }

  @media (max-width: 767px) {
    .hp-hero-marquee { display: none; }
  }
  
  @media (orientation: landscape) and (max-height: 500px) and (pointer: coarse) {
    .hp-hero-marquee { display: none; }
  }

  .hp-hero-logos {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    pointer-events: none;
  }
  
  @media (max-width: 767px) and (orientation: portrait) {
    .hp-hero-logos { display: flex; padding-bottom: 2rem; }
  }

  .hp-hero-logo {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    color: var(--color-brand-500);
    background: color-mix(in oklch, var(--color-brand-500) 12%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hp-hero-logos {
      animation: hp-hero-marquee-fade 0.6s ease-out 1.2s backwards;
    }
  }
</style>

</LandingLayout>